---
extends: default

ignore: |
  output/
  .venv/
  node_modules/

rules:
  comments-indentation: disable
  comments:
    ## yamllint and the RedHat YAML VSCode extension fight over this rule,
    #  and it's less painful to just make yamllint handle RedHat's formatting.
    min-spaces-from-content: 1

  line-length:
    disable
    # max: 120
    # level: warning

  document-start: disable

  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
