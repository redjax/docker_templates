## Default: latest
MINDWTR_IMG_TAG=
## Default: 8787
MINDWTR_PORT=
## Default: (none/empty)
#  Generate with openssl rand -hex 32
MINDWTR_CLOUD_AUTH_TOKENS=
## Default: https://tasks.example.com
#  If hosting the PWA, set this to the URL
#  you access the Mindwtr app from.
MINDWTR_CLOUD_CORS_ORIGIN=
## Default: (named volume) cloud_data
MINDWTR_DATA_DIR=

