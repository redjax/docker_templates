## Default: registry.defectdojo.com
DD_IMAGE_REGISTRY=

## Default: latest
NGINX_VERSION=

## Default: false
NGINX_METRICS_ENABLED=

## Default: 8080
DD_PORT=

## Default: 8443
DD_TLS_PORT=

## Default: latest
DJANGO_VERSION=

## Default: postgres
DD_DATABASE_HOST=

## Default: 5432
DD_DATABASE_PORT=

## Default: False
DD_DJANGO_METRICS_ENABLED=

## Default: *
DD_ALLOWED_HOSTS=

## Default: postgresql://defectdojo:defectdojo@postgres:5432/defectdojo
DD_DATABASE_URL=

## Default: redis://valkey:6379/0
DD_CELERY_BROKER_URL=

## Default: redis://valkey:6379/1
DD_CACHE_URL=

## Required: generate with ./scripts/generate-secrets.sh
DD_SECRET_KEY=

## Required: generate with ./scripts/generate-secrets.sh
DD_CREDENTIAL_AES_256_KEY=

## Default: 30
DD_DATABASE_READINESS_TIMEOUT=

## Default: ./docker/extra_settings
DD_EXTRA_SETTINGS_DIR=

## Default: named volume defectdojo_media
## Set to a host path to use bind-mounted media storage instead.
DD_MEDIA_DIR=

## Local PostgreSQL overlay
## Defaults match the upstream template.
DD_DATABASE_NAME=
DD_DATABASE_USER=
DD_DATABASE_PASSWORD=

## Initial administrator
## Default: admin
DD_ADMIN_USER=

## Default: admin@defectdojo.local
DD_ADMIN_MAIL=

## Default: Admin
DD_ADMIN_FIRST_NAME=

## Default: User
DD_ADMIN_LAST_NAME=

## Default: true
DD_INITIALIZE=
