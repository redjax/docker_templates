#################
# Open Archiver #
#################

## Default: v0.5.2
OA_IMG_TAG=
## Default: 3000
OA_ARCHIVER_WEBUI_PORT=
## Default: (named volume) archiver_data
OA_DATA_DIR=

#########################
# Open Archiver Runtime #
#########################

NODE_ENV=production
PORT_BACKEND=4000
PORT_FRONTEND=3000

## Set both to the externally reachable URL.
APP_URL=http://<IP+Port or FQDN>
ORIGIN=${APP_URL}

SYNC_FREQUENCY=17 */6 * * *
ALL_INCLUSIVE_ARCHIVE=false

## Start conservatively; raise after observing memory/CPU during a full ingest.
INGESTION_WORKER_CONCURRENCY=2

## Maximum UI-upload size. Use Local Path ingestion for very large local MBOX/PST files.
BODY_SIZE_LIMIT=100M

## Local mail/attachment storage path INSIDE the container.
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT_PATH=/var/data/open-archiver

## Safety: disable email/source deletion by default.
ENABLE_DELETION=false

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

## Generate with: openssl rand -hex 32
# Keep permanently. Losing/changing it can make encrypted stored data unreadable.
STORAGE_ENCRYPTION_KEY=

## Generate with: openssl rand -base64 48
# Used to sign application login/session tokens.
JWT_SECRET=
JWT_EXPIRES_IN=7d

## Generate with: openssl rand -hex 32
# Keep permanently. Encrypts ingestion-source credentials, IMAP passwords, and OAuth tokens.
ENCRYPTION_KEY=

############
# Postgres #
############

## Default: 17-alpine
POSTGRES_IMG_TAG=
## Default: open_archive
POSTGRES_DB=open_archive
## Default: openarchiver
POSTGRES_USER=openarchiver
## Default: set POSTGRES_PASSWORD
POSTGRES_PASSWORD=
## Default: db_data
POSTGRES_DATA_DIR=

## Runtime value
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

###############
# Meilisearch #
###############

## Default: v1.53.1
MEILI_IMG_TAG=
## Default: set MEILI_MASTER_KEY
MEILI_MASTER_KEY=
## Default: 86400
MEILI_SCHEDULE_SNAPSHOT=86400
## Default: meili_data
MEILI_DATA_DIR=

#######################
# Meilisearch Runtime #
#######################

MEILI_HOST=http://meilisearch:7700
MEILI_INDEXING_BATCH=500
MEILI_INDEXING_CHUNK=25
INDEXING_MAX_TEXT_BYTES=1000000
INDEXING_WORKER_MAX_OLD_SPACE_MB=2048
## Default: false
MEILI_DO_DB_MIGRATIONS=

########
# Tika #
########

## Default: 3.3.1.0-full
TIKA_IMG_TAG=

################
# Tika Runtime #
################

TIKA_URL=http://tika:9998
PDF_PARSE_TIMEOUT_MS=20000

##########
# Valkey #
##########

## Default: 8-alpine
VALKEY_IMG_TAG=
## Default: set REDIS_PASSWORD
REDIS_PASSWORD=
## Default: valkey_data
VALKEY_DATA_DIR=

##################
# Valkey Runtime #
##################

REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_USER=default
REDIS_TLS_ENABLED=false
