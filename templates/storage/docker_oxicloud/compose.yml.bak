---
name: oxicloud

services:
  postgres:
    image: postgres:${POSTGRES_IMG_TAG:-18.2-alpine3.23}
    container_name: oxicloud-postgres
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-oxicloud}
      POSTGRES_USER: ${POSTGRES_USER:-oxicloud}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?Set POSTGRES_PASSWORD in .env}
    volumes:
      - ${POSTGRES_DATA_DIR:-./data/postgres}:/var/lib/postgresql
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U "$$POSTGRES_USER" -d "$$POSTGRES_DB"
      interval: 5s
      timeout: 5s
      retries: 12
      start_period: 10s

  oxicloud:
    image: diocrafts/oxicloud:${OXICLOUD_IMG_TAG:-0.8.9}
    container_name: oxicloud
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      OXICLOUD_DB_CONNECTION_STRING: >-
        postgres://${POSTGRES_USER:-oxicloud}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-oxicloud}
      OXICLOUD_STORAGE_PATH: /app/storage
      OXICLOUD_SERVER_HOST: 0.0.0.0
      OXICLOUD_SERVER_PORT: 8086
      OXICLOUD_BASE_URL: ${OXICLOUD_BASE_URL:-http://localhost:8086}
      OXICLOUD_COOKIE_SECURE: ${OXICLOUD_COOKIE_SECURE:-false}

      OXICLOUD_STORAGE_LOCAL_TYPE: local
      OXICLOUD_STORAGE_LOCAL_PATH: /app/storage

      OXICLOUD_STORAGE_DEFAULT_ENCRYPTION_KEY: ${OXICLOUD_STORAGE_DEFAULT_ENCRYPTION_KEY?Set OXICLOUD_STORAGE_ENCRYPTION_KEY in .env}
    volumes:
      - ${OXICLOUD_DATA_DIR:-./data/storage}:/app/storage
    ports:
      - "${OXICLOUD_BIND_ADDRESS:-0.0.0.0}:${OXICLOUD_PORT:-8086}:8086"

