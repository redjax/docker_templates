## Default: 18.2-alpine3.23
POSTGRES_IMG_TAG=
## Default: 0.8.9
OXICLOUD_IMG_TAG=

## Default: oxicloud
POSTGRES_DB=
## Default: oxicloud
POSTGRES_USER=
## Default: (none/empty)
POSTGRES_PASSWORD=
## Default: ./data/postgres
POSTGRES_DATA_DIR=

## Default: http://localhost:8086
OXICLOUD_BASE_URL=
## Default: false
#  Set to true when using HTTPS, i.e. behind a reverse proxy
OXICLOUD_COOKIE_SECURE=

## Default: 0.0.0.0
OXICLOUD_BIND_ADDRESS=
## Default: 8086
OXICLOUD_PORT=
## Default: ./data/storage
OXICLOUD_DATA_DIR=
## Default: (none/empty)
OXICLOUD_STORAGE_ENCRYPTION_KEY=

## Default: (none/empty)
OXICLOUD_SMTP_HOST=
## Default: 587
OXICLOUD_SMTP_PORT=587
## Default: (none/empty)
OXICLOUD_SMTP_USER=
## Default: (none/empty)
OXICLOUD_SMTP_PASS=
## Default: (none/empty)
#  Example: OxiCloud <oxicloud@example.com>
OXICLOUD_SMTP_FROM=
## Default: starttls
OXICLOUD_SMTP_TLS=starttls

## Default: false
OXICLOUD_ENABLE_PLUGINS=
## Default: 250
OXICLOUD_PLUGIN_TIMEOUT_MS=
## Default: 256
OXICLOUD_PLUGIN_MAX_MEMORY_PAGES=
## Default: 262144
OXICLOUD_PLUGIN_MAX_INPUT_BYTES=
## Default: 4
OXICLOUD_PLUGIN_MAX_CONCURRENT_INVOCATIONS=
## Default: 300
OXICLOUD_PLUGIN_CACHE_IDLE_TTL_SECS=
## Default: 5242880
OXICLOUD_PLUGIN_LOG_MAX_FILE_BYTES=
## Default: 10
OXICLOUD_PLUGIN_LOG_MAX_SEGMENTS=
## Default: 30
OXICLOUD_PLUGIN_LOG_RETENTION_DAYS=
## Default: 268435456
OXICLOUD_PLUGIN_LOG_TOTAL_MAX_BYTES=
## Default: 1024
OXICLOUD_PLUGIN_LOG_QUEUE_CAPACITY=
