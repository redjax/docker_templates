## Default: 1000
PGID=

## Default: latest
ARCANE_IMG_TAG=
## Default: 0.0.0.0:3552
ARCANE_PORT=
## Default: (none/empty)
ARCANE_APP_URL=
## Default: (none/unset)
ARCANE_ENCRYPTION_KEY=
## Default: /opt/docker
ARCANE_PROJECTS_DIRECTORY=
## Default: 3
ARCANE_PROJECT_SCAN_MAX_DEPTH=

## Default: info
ARCANE_LOG_LEVEL=
## Default: false
ARCANE_LOG_JSON=
## Default: true
ARCANE_ANALYTICS_DISABLED=

## Default: 2
CADDY_IMG_TAG=
## Default: ./caddy/Caddyfile
