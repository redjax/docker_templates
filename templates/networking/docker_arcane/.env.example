#  i.e. a LAN IP and VPN IP.
CADDY_SITE_ADDRESSES=
## Default: 80
CADDY_HTTP_PORT=
## Default: 443
CADDY_HTTPS_PORT=
## Default: internal
CADDY_TLS_ISSUER=

## Default: (named volume) caddy-data
CADDY_DATA_DIR=
## Default: (named volume) caddy-config
CADDY_CONFIG_DIR=
