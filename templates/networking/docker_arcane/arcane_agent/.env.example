## Latest
ARCANE_IMG_TAG=
## Default: (none/empty)
ARCANE_AGENT_TOKEN=
## Default: (none/empty)
ARCANE_MANAGER_URL=
## Default: agent-data
ARCANE_AGENT_DATA_DIR=
## Default: /opt/docker
ARCANE_PROJECTS_DIRECTORY=

## Default: 3553
#  This is only needed when using the direct.yml layer
ARCANE_AGENT_PORT=

## Default: poll
#  This is only needed when using the edge.yml layer
#  Options:
#    - `poll`: Checks in periodically. The first action after an idle period may take a moment.
#    - `auto`: Maintains a continuous tunnel, preferring gRPC and falling back to WebSocket.
#    - `websocket`: Maintains a continuous WebSocket tunnel.
#    - `grpc`: Maintains a continuous gRPC tunnel with no WebSocket fallback.
ARCANE_EDGE_TRANSPORT=
