## Default: 9
KOMODO_IMG_TAG=
## Default: latest
MONGODB_IMG_TAG=

## Default: 9120
KOMODO_HTTP_PORT=
## Default: ./.env
KOMODO_ENV_FILE=
## Default: mongo:27017
KOMODO_DATABASE_ADDRESS=
## Default: (named volume) keys
KOMODO_KEYS_DIR=
## Default: (named volume) backups
KOMODO_BACKUPS_PATH=

## Default: etc_komodo
KOMODO_PERIPHERY_ROOT_DIRECTORY=

## Default: komodo
KOMODO_DATABASE_USERNAME=
## Default: komodo
KOMODO_DATABASE_PASSWORD=
## Default: (named volume) mongo-data
MONGODB_DATA_DIR=
## Default: (named  volume) mongo-config
MONGODB_CONFIG_DIR=

## Default: 2
CADDY_IMG_TAG=
## Default: 80
CADDY_HTTP_PORT=
## Default: 443
CADDY_HTTPS_PORT=
## Default: ./Caddyfile
CADDY_CADDYFILE=
## Default: (named volume) caddy-data
CADDY_DATA_DIR=
## Default: (named volume) caddy-config
CADDY_CONFIG_DIR=
## Default: (none/empty)
#  Examples:
#    KOMODO_TLS_NAMES=192.168.1.50
#    KOMODO_TLS_NAMES=192.168.1.50 komodo.home.arpa
#    KOMODO_TLS_NAMES=komodo.example.com
KOMODO_TLS_NAMES=
## Default: (none/empty)
#  For IP-only access, set this to the server's IP.
#  For hostname access, set it to the primary hostname.
KOMODO_DEFAULT_SNI=
