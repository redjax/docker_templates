## Default: 9
KOMODO_IMG_TAG=
## Default: latest
MONGODB_IMG_TAG=

## Default: 9120
KOMODO_HTTP_PORT=
## Default: ./.env
KOMODO_ENV_FILE=
## Default: mongo:27017
KOMODO_DATABASE_ADDRESS=
## Default: (named volume) keys
KOMODO_KEYS_DIR=
## Default: (named volume) backups
KOMODO_BACKUPS_PATH=

## Default: /etc/komodo
#  Real path on host when Komodo targets this machine as a server
KOMODO_PERIPHERY_ROOT_DIRECTORY=

## Default: komodo
KOMODO_DATABASE_USERNAME=
## Default: komodo
KOMODO_DATABASE_PASSWORD=
## Default: (named volume) mongo-data
MONGODB_DATA_DIR=
## Default: (named  volume) mongo-config
MONGODB_CONFIG_DIR=

## Default: 2
KOMODO_CADDY_IMG_TAG=
## Default: 80
KOMODO_CADDY_HTTP_PORT=
## Default: 443
KOMODO_CADDY_HTTPS_PORT=
## Default: ./Caddyfile
KOMODO_CADDY_CADDYFILE=
## Default: (named volume) caddy-data
KOMODO_CADDY_DATA_DIR=
## Default: (named volume) caddy-config
KOMODO_CADDY_CONFIG_DIR=
## Default: (none/empty)
#  Examples:
#    KOMODO_TLS_NAMES=192.168.1.50
#    KOMODO_TLS_NAMES=192.168.1.50 komodo.home.arpa
#    KOMODO_TLS_NAMES=komodo.example.com
KOMODO_TLS_NAMES=
## Default: (none/empty)
#  For IP-only access, set this to the server's IP.
#  For hostname access, set it to the primary hostname.
KOMODO_DEFAULT_SNI=

## Default: (none/empty)
#  Used for OAuth2/OpenID auth, i.e. Authentik
KOMODO_HOST=

## Default: false
KOMODO_OIDC_ENABLED=
## Default: (none/empty)
#  Example: https://auth.example.com/application/o/komodo/
KOMODO_OIDC_PROVIDER=
## Default: (none/empty)
KOMODO_OIDC_CLIENT_ID=
## Default: (none/empty)
KOMODO_OIDC_CLIENT_SECRET=

## Default: latest
GOTIFY_ALERTER_IMG_TAG=
## Default: (none/empty)
GOTIFY_ALERTER_URL=
## Default: (none/empty)
GOTIFY_ALERTER_APP_TOKEN=
## Default: 3
GOTIFY_ALERTER_OK_PRIORITY=
## Default: 5
GOTIFY_ALERTER_WARNING_PRIORITY=
## Default: 8
GOTIFY_ALERTER_CRITICAL_PRIORITY=

