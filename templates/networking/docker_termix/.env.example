## Default: latest
TERMIX_IMG_TAG=
## Default: 8080
TERMIX_HTTP_PORT=
## Default: (named volume) termix_data
TERMIX_DATA_DIR=
## Default: false
#  Set to 'true' if you've configured OAuth2/OIDC login
#  and want to disable logging in with the regular webform
TERMIX_OIDC_SILENT_LOGIN_DEFAULT=
## Default: true
#  Set to 'false' if you've set up OIDC and want to only
#  allow logins using your IdP (i.e. Authentik)
TERMIX_ALLOW_PASSWORD_LOGIN=

