## Default: latest
WUD_IMG_TAG=
## Default: 127.0.0.1:3000
WUD_PORT=
## Default: (named volume) wud-data
WUD_DATA_DIR=
## Default: (none/empty)
#  Set to path on your host where Docker Compose stacks live.
#  Mounts that path in the container so WUD can auto-update them.
#
#  This is required when running with -f overlays/compose-stacks.yml
WUD_STACKS_DIR=
## Default: (none/empty)
#  Original path recorded in Docker Compose labels
#
#  This is required when running with -f overlays/compose-stacks.yml
WUD_STACKS_LABEL_PATH=

## Default: admin
WUD_ADMIN_USERNAME=
## Default: none/empty
WUD_ADMIN_PASSWORD=

## Default: 0 * * * *
WUD_CRON=
## Default: true
WUD_WATCHBYDEFAULT=
## Default: true
WUD_WATCHATSTART=
## Default: true
WUD_WATCHEVENTS=

## Default: (none/empty)
WUD_NTFY_URL=
## Default: (none/empty)
WUD_NTFY_TOPIC=
## Default: (none/empty)
WUD_NTFY_TOKEN=

## Default: (none/empty)
WUD_GOTIFY_URL=
## Default: (none/empty)
WUD_GOTIFY_TOKEN=

## Default: (none/empty)
WUD_APPRISE_URL=
## Default: false
WUD_COMPOSE_AUTO=
## Default: false
WUD_COMPOSE_INCLUDEBYDEFAULT=
## Default: true
WUD_COMPOSE_BACKUP=
## Default: true
WUD_COMPOSE_ROLLBACK=
