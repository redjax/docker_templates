###########
# Forgejo #
###########

## Default: 16
FORGEJO_IMG_VER=
## Default: 1000
FORGEJO_UUID=
## Default: 1000
FORGEJO_GUID=

## Default: ./env_files/forgejo/default.env
FORGEJO_ENV_FILE=
## Default: ./data/forgejo
FORGEJO_DATA_DIR=
## Default: 3000
FORGEJO_WEBUI_PORT=
## Default: 222
FORGEJO_SSH_PORT=

#############
# Authentik #
#############

## Default: ghcr.io/goauthentik/server
AUTHENTIK_IMAGE=
## Default: 2025.6.4
AUTHENTIK_TAG=
## Default: 9000
AUTHENTIK_HTTP_PORT=
## Default: 9443
AUTHENTIK_HTTPS_PORT=
## Default: (named volume) authentik_db_data
AUTHENTIK_DB_DATA_DIR=
## Default: (named volume) authentik_redis_data
AUTHENTIK_REDIS_DATA_DIR=
## Default: authentik_media
AUTHENTIK_MEDIA_DIR=
## Default: authentik_custom_templates
AUTHENTIK_CUSTOM_TEMPLATES_DIR=
## Default: authentik_certs
AUTHENTIK_CERTS_DIR=
## Default: database password required
AUTHENTIK_DB_PASS=
## Default: 'secret key required'
AUTHENTIK_SECRET_KEY=
## Default: authentik
AUTHENTIK_DB_USER=
## Default: authentik
AUTHENTIK_DB_DATABASE=

###########
# Traefik #
###########

## Default: 80
TRAEFIK_HTTP_PORT=
## Default: 443
TRAEFIK_HTTPS_PORT=
## Default: none@example.com
TRAEFIK_ACME_EMAIL=
## Default: git.example.com
TRAEFIK_DOMAIN=
## Default: ./data/traefik/letsencrypt
TRAEFIK_LETSENCRYPT_DIR=
## Default: none/unset
CF_API_TOKEN=

##########
# Anubis #
##########

## Default: latest
ANUBIS_IMG_TAG=

## Default: 3.24
#  Latest Alpine tag:
#    https://hub.docker.com/_/alpine/tags
ANUBIS_INIT_IMG_TAG=

## Default: 127.0.0.1:8923
ANUBIS_LOCAL_PORT=

## Default: 4
#  https://anubis.techaro.lol/docs/admin/policies#challenge-configuration
ANUBIS_DIFFICULTY=

## Default: INFO
ANUBIS_LOG_LEVEL=

## Default: (none/empty)
#  Generate with: openssl rand -hex 32
ANUBIS_SIGNING_KEY=

## Default: (named volume) anubis_data
ANUBIS_DATA_DIR=

################
# Offen backup #
################

## Default: v2
OFFEN_BACKUP_IMG_TAG=

## Default: Etc/UTC 
OFFEN_BACKUP_TZ=
## Default: 30 4 * * *
#  Daily at 04:30 in the given timezone,
#  following daylight-saving changes.
OFFEN_BACKUP_CRON=

## Default: (none/empty)
#  Your S3-compatible bucket name
OFFEN_BACKUP_S3_BUCKET=

## Default: (none/empty)
#  The "folder" inside your bucket where backups are uploaded.
OFFEN_BACKUP_S3_PREFIX=

## Default: (none/empty)
#  Endpoint hostname only: no https:// and no bucket path.
OFFEN_BACKUP_S3_ENDPOINT=
## Default: auto
OFFEN_BACKUP_S3_BUCKET_LOOKUP=

## Default: (none/empty)
#  Existing S3 access key ID
OFFEN_BACKUP_S3_ACCESS_KEY_ID=
## Default: (none/empty)
#  Existing S3 access key secret
OFFEN_BACKUP_S3_SECRET_ACCESS_KEY=

##
#  Generate with: openssl rand -hex 32
#  Or use ./scripts/generate-secrets.sh
OFFEN_BACKUP_AGE_PASSPHRASE=

## Default: -1
#  -1 disables backup pruning.
OFFEN_BACKUP_RETENTION_DAYS=

## Default: (none/empty)
#  Example with Gotify:
#  'gotify://gotify.example.com:443/YOUR_APPLICATION_TOKEN/?title=Forgejo+backups&priority=5'
OFFEN_BACKUP_NOTIFICATION_URLS=
## Default: error
OFFEN_BACKUP_NOTIFICATION_LEVEL=
